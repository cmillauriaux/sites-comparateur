---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import siteConfig from '../../../site.config.js';
import { i18n } from '@comparateur/config';
const s = i18n(siteConfig.market);

const all = await getCollection('articles', ({ data }) => !data.draft && data.intent === 'avis');
all.sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
---
<SiteLayout title={`${s.navReviews} — ${siteConfig.name}`} description={s.pageReviewsIntro}>
  <div class="mx-auto max-w-[var(--max-w-page)] px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-6">{s.allReviews}</h1>
    <p class="text-[var(--color-text-muted)] mb-8 max-w-3xl">{s.pageReviewsIntro}</p>
    {all.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">{s.noReviews}</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {all.map((a) => <ArticleCard href={`/avis/${a.id}/`} title={a.data.title} description={a.data.description} intent={a.data.intent} publishedAt={a.data.publishedAt} heroImage={a.data.heroImage} finalScore={a.data.finalScore} />)}
      </div>
    )}
  </div>
</SiteLayout>
