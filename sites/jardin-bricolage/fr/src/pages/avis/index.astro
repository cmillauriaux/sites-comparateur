---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const all = await getCollection('articles', ({ data }) => !data.draft && data.intent === 'avis');
all.sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
---
<SiteLayout title="Tests produit — JardinGuide" description="Nos tests détaillés d'outils de jardin et de bricolage. Notes par critère, verdict final, sources vérifiées.">
  <div class="mx-auto max-w-[var(--max-w-page)] px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-6">Tous les tests</h1>
    <p class="text-[var(--color-text-muted)] mb-8 max-w-3xl">Chaque test est appuyé par au minimum 2 sources vérifiées (Que Choisir, Les Numériques, retailers spécialisés). Note finale = moyenne pondérée des notes par critère.</p>
    {all.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">Aucun test publié pour le moment.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {all.map((a) => <ArticleCard href={`/avis/${a.id}/`} title={a.data.title} description={a.data.description} intent={a.data.intent} publishedAt={a.data.publishedAt} heroImage={a.data.heroImage} finalScore={a.data.finalScore} />)}
      </div>
    )}
  </div>
</SiteLayout>
