---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const all = await getCollection('articles', ({ data }) => !data.draft && data.intent === 'comparatif');
all.sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
---
<SiteLayout title="Comparatifs — JardinGuide" description="Nos comparatifs argumentés : critères de choix, présentation produit par produit, tableau récapitulatif. Sources vérifiées.">
  <div class="mx-auto max-w-[var(--max-w-page)] px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-6">Tous les comparatifs</h1>
    <p class="text-[var(--color-text-muted)] mb-8 max-w-3xl">Chaque comparatif commence par les critères de choix, présente brièvement chaque produit retenu, et se conclut par un tableau récapitulatif assorti d'une recommandation finale.</p>
    {all.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">Aucun comparatif publié pour le moment.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {all.map((a) => <ArticleCard href={`/comparatifs/${a.id}/`} title={a.data.title} description={a.data.description} intent={a.data.intent} publishedAt={a.data.publishedAt} heroImage={a.data.heroImage} />)}
      </div>
    )}
  </div>
</SiteLayout>
