---
import SiteLayout from '../layouts/SiteLayout.astro';
import siteConfig from '../../site.config.js';

const copy = {
  fr: { title: 'Page introuvable', body: "Cette page n'existe pas ou a été déplacée.", cta: "Retour à l'accueil" },
  us: { title: 'Page not found',  body: "This page doesn't exist or has been moved.", cta: 'Back to home' },
  gb: { title: 'Page not found',  body: "This page doesn't exist or has been moved.", cta: 'Back to home' },
};
const c = copy[siteConfig.market] ?? copy.fr;
---
<SiteLayout title={c.title} description={c.body} noindex>
  <div class="mx-auto max-w-2xl px-4 py-20 text-center">
    <h1 class="text-5xl font-bold text-[var(--color-primary-dark)] mb-3">404</h1>
    <p class="text-[var(--color-text-muted)] mb-6">{c.body}</p>
    <a href="/" class="rounded-md bg-[var(--color-primary)] text-white px-5 py-3 font-semibold">{c.cta}</a>
  </div>
</SiteLayout>
