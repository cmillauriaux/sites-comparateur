---
import siteConfig from '../../site.config.js';
import { i18n } from '@comparateur/config';
const s = i18n(siteConfig.market);
const { compact = false } = Astro.props;
---
<aside class:list={[
  "rounded-md border border-[var(--color-accent-light)] bg-[var(--color-hero-bg)] text-sm text-[var(--color-text-muted)]",
  compact ? "px-3 py-2" : "px-4 py-3 my-6"
]}>
  <p class="m-0">
    <strong>{s.disclosureLabel}</strong> — {s.disclosureBody}
  </p>
</aside>
