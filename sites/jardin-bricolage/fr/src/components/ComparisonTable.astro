---
import AffiliateButton from './AffiliateButton.astro';

interface Product {
  name: string;
  score?: number;
  asin?: string | null;
  image?: string;       // chemin résolu par l'article-generator post-pass ("auto:..." → /images/products/...)
  price?: string;       // injecté par le pipeline depuis Amazon (ex: "89,99 €")
  program?: string;
  criteria?: Record<string, number | string>;
}
interface Props {
  products: Product[];
  criteria?: string[];
  criteriaLabels?: Record<string, string>;
}
const { products, criteria, criteriaLabels = {} } = Astro.props;

const allCriteria = criteria
  ?? Array.from(new Set(products.flatMap(p => Object.keys(p.criteria ?? {}))));

const labelFor = (key: string) =>
  criteriaLabels[key] ?? key.charAt(0).toUpperCase() + key.slice(1).replace(/([A-Z])/g, ' $1');

const imageFor = (p: Product) =>
  (p.image && !p.image.startsWith('auto:')) ? p.image : null;

// Per-column maxes — used to bold the leader(s) in each criterion + global score.
// Ties are intentional: multiple rows can be bolded.
const numericVal = (v: number | string | undefined) => {
  const n = typeof v === 'number' ? v : Number(v);
  return Number.isFinite(n) ? n : null;
};
const maxByCriterion: Record<string, number> = {};
for (const c of allCriteria) {
  const vals = products.map(p => numericVal(p.criteria?.[c])).filter((v): v is number => v !== null);
  if (vals.length) maxByCriterion[c] = Math.max(...vals);
}
const scoreVals = products.map(p => p.score).filter((v): v is number => typeof v === 'number');
const maxScore = scoreVals.length ? Math.max(...scoreVals) : null;

const isLeaderCriterion = (p: Product, c: string) => {
  const v = numericVal(p.criteria?.[c]);
  return v !== null && v === maxByCriterion[c];
};
const isLeaderScore = (p: Product) =>
  maxScore !== null && p.score === maxScore;
---
<div class="not-prose my-8 overflow-x-auto rounded-lg border border-[var(--color-border)]">
  <table class="w-full text-sm">
    <thead class="bg-[var(--color-hero-bg)] text-[var(--color-primary-dark)]">
      <tr>
        <th class="px-2 py-2 text-left font-semibold w-20">&nbsp;</th>
        <th class="px-2 py-2 text-left font-semibold">Produit</th>
        {allCriteria.map(c => <th class="px-2 py-2 text-center font-semibold w-14 whitespace-nowrap">{labelFor(c)}</th>)}
        <th class="px-2 py-2 text-center font-semibold w-12 whitespace-nowrap">Note</th>
        <th class="px-2 py-2 text-center font-semibold w-32 whitespace-nowrap">Prix</th>
      </tr>
    </thead>
    <tbody>
      {products.map((p) => {
        const img = imageFor(p);
        return (
          <tr class="border-t border-[var(--color-border)]">
            <td class="px-2 py-3">
              {img ? (
                <img
                  src={img}
                  alt={p.name}
                  loading="lazy"
                  class="w-16 h-16 object-contain rounded bg-[var(--color-hero-bg)]"
                  onerror="this.style.visibility='hidden'"
                />
              ) : (
                <div class="w-16 h-16 rounded bg-[var(--color-hero-bg)]"></div>
              )}
            </td>
            <td class="px-2 py-3 font-semibold text-[var(--color-primary-dark)]">{p.name}</td>
            {allCriteria.map(c => {
              const leader = isLeaderCriterion(p, c);
              return (
                <td class:list={[
                  "px-2 py-3 text-center tabular-nums",
                  leader && "font-bold text-[var(--color-primary-dark)]",
                ]}>
                  {p.criteria?.[c] ?? '—'}
                </td>
              );
            })}
            <td class:list={[
              "px-2 py-3 text-center whitespace-nowrap tabular-nums",
              isLeaderScore(p) && "font-bold text-[var(--color-primary-dark)]",
            ]}>
              {p.score !== undefined ? `${p.score}/10` : '—'}
            </td>
            <td class="px-2 py-3 text-center whitespace-nowrap">
              {p.price && (
                <p class="font-semibold tabular-nums text-[var(--color-primary-dark)] mb-1">{p.price}</p>
              )}
              <AffiliateButton
                product={p.name}
                asin={p.asin ?? undefined}
                program={p.program}
                variant="secondary"
              >
                {p.price ? 'Voir l\'offre' : 'Voir le prix'}
              </AffiliateButton>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
