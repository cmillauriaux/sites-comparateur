---
interface SourceEntry { name: string; url: string; domain: string; scrapedAt: Date | string }
interface Props { sources: SourceEntry[]; groundingScore?: string }
const { sources, groundingScore } = Astro.props;
const fmt = (d: Date | string) => {
  const date = typeof d === 'string' ? new Date(d) : d;
  return date.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
};
---
<section class="mt-12 border-t border-[var(--color-border)] pt-6 not-prose">
  <h2 class="text-lg font-semibold text-[var(--color-primary-dark)] mb-3">Sources consultées</h2>
  <p class="text-sm text-[var(--color-text-muted)] mb-3">
    Cet article s'appuie sur {sources.length} sources vérifiées{groundingScore ? ` (couverture : ${groundingScore})` : ''}. Toutes les informations factuelles (prix, specs, classements) en proviennent.
  </p>
  <ul class="text-sm space-y-1">
    {sources.map((s) => (
      <li>
        <a href={s.url} rel="nofollow noopener" target="_blank" class="text-[var(--color-primary)] hover:underline">
          {s.name}
        </a>
        <span class="text-[var(--color-text-muted)]"> — consulté le {fmt(s.scrapedAt)}</span>
      </li>
    ))}
  </ul>
</section>
