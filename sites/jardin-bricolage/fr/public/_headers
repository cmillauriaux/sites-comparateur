# Cloudflare Pages headers — cache strategy
#
# Pages serves /* with `cache-control: public, max-age=0, must-revalidate` by
# default, which keeps cf-cache-status=DYNAMIC (no edge cache, every request
# hits the origin). For a daily-rebuilt static site this is wasteful: we can
# safely let the edge cache HTML between deploys because Cloudflare Pages
# automatically purges the cache on each successful deploy.
#
# Strategy:
#   - HTML / XML / TXT: short browser TTL, long edge TTL, generous SWR.
#   - Hashed Astro bundles (/_astro/*): immutable, 1 year (filenames change).
#   - Images / fonts: long browser+edge cache, no immutable (filenames may be
#     overwritten when we re-generate hero images).
#
# Rules later in the file override earlier ones for the same matching path,
# so the catch-all comes first and the more specific patterns refine it.

/*
  Cache-Control: public, max-age=300, s-maxage=86400, stale-while-revalidate=604800

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/open-graph.webp
  Cache-Control: public, max-age=604800

# robots.txt / sitemap / llms.txt / rss should refresh quickly when content
# changes — short edge TTL is intentional.
/robots.txt
  Cache-Control: public, max-age=300, s-maxage=3600

/sitemap-index.xml
  Cache-Control: public, max-age=300, s-maxage=3600

/sitemap-0.xml
  Cache-Control: public, max-age=300, s-maxage=3600

/llms.txt
  Cache-Control: public, max-age=300, s-maxage=3600

/rss.xml
  Cache-Control: public, max-age=300, s-maxage=3600
