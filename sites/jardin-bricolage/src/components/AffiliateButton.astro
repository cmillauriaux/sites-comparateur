---
/**
 * Bouton CTA d'affiliation. Construit le href automatiquement quand `product`
 * est fourni et qu'aucun href n'est passé : URL de recherche Amazon.fr avec
 * le tag d'affiliation injecté depuis AMAZON_AFFILIATE_ID.
 *
 * Awin est désactivé tant qu'aucun ID Awin n'est configuré dans .env. Si tu
 * passes `program="awin-..."` mais que le programme n'a pas d'advertiserId,
 * on retombe sur Amazon search.
 */
interface Props {
  href?: string;
  product?: string;
  asin?: string;
  program?: 'amazon' | string;
  variant?: 'primary' | 'secondary';
}
const { href, product, asin, program = 'amazon', variant = 'primary' } = Astro.props;

const amazonTag = import.meta.env.AMAZON_AFFILIATE_ID || process.env.AMAZON_AFFILIATE_ID || '';

function buildAmazonUrl() {
  const tagSuffix = amazonTag ? `&tag=${encodeURIComponent(amazonTag)}` : '';
  if (asin) return `https://www.amazon.fr/dp/${asin}/?${tagSuffix.slice(1)}`;
  if (product) return `https://www.amazon.fr/s?k=${encodeURIComponent(product)}${tagSuffix}`;
  return `https://www.amazon.fr/${tagSuffix.replace(/^&/, '?')}`;
}

const finalHref = href || buildAmazonUrl();
const label = program === 'amazon' ? 'Voir sur Amazon' : 'Voir le prix';
---
<a
  href={finalHref}
  rel="sponsored nofollow noopener"
  target="_blank"
  data-affiliate={program}
  data-product={product}
  class:list={[
    "inline-flex items-center gap-2 rounded-md px-5 py-3 font-semibold text-center no-underline transition-colors",
    variant === 'primary'
      ? "bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-dark)]"
      : "border-2 border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white",
  ]}
>
  <slot>{label}{product ? ` — ${product}` : ''}</slot>
  <span aria-hidden="true">→</span>
</a>
