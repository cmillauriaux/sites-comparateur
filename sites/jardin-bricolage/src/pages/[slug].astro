---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('page', ({ data }) => !data.draft);
  return all.map(p => ({ params: { slug: p.id }, props: { page: p } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<SiteLayout title={page.data.title} description={page.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-6">{page.data.title}</h1>
    <div class="prose prose-lg max-w-none"><Content /></div>
  </article>
</SiteLayout>
