---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <div class="mx-auto max-w-2xl px-4 py-20 text-center">
    <h1 class="text-5xl font-bold text-[var(--color-primary-dark)] mb-3">404</h1>
    <p class="text-[var(--color-text-muted)] mb-6">Cette page n'existe pas ou a été déplacée.</p>
    <a href="/" class="rounded-md bg-[var(--color-primary)] text-white px-5 py-3 font-semibold">Retour à l'accueil</a>
  </div>
</SiteLayout>
