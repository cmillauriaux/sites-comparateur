---
import siteConfig from '../../site.config.js';
import { i18n } from '@comparateur/config';
const s = i18n(siteConfig.market);

interface SourceEntry { name: string; url: string; domain: string; scrapedAt: Date | string }
interface Props { sources: SourceEntry[]; groundingScore?: string }
const { sources, groundingScore } = Astro.props;
const fmt = (d: Date | string) => {
  const date = typeof d === 'string' ? new Date(d) : d;
  return date.toLocaleDateString(siteConfig.locale ?? 'fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
};
---
<section class="mt-12 border-t border-[var(--color-border)] pt-6 not-prose">
  <h2 class="text-lg font-semibold text-[var(--color-primary-dark)] mb-3">{s.sourcesHeading}</h2>
  <p class="text-sm text-[var(--color-text-muted)] mb-3">
    {s.sourcesBlurb(sources.length, groundingScore)}
  </p>
  <ul class="text-sm space-y-1">
    {sources.map((src) => (
      <li>
        <a href={src.url} rel="nofollow noopener" target="_blank" class="text-[var(--color-primary)] hover:underline">
          {src.name}
        </a>
        <span class="text-[var(--color-text-muted)]"> — {s.consultedOn} {fmt(src.scrapedAt)}</span>
      </li>
    ))}
  </ul>
</section>
