---
import siteConfig from '../../site.config.js';
import { i18n } from '@comparateur/config';
const s = i18n(siteConfig.market);

interface Props {
  href: string;
  title: string;
  description: string;
  intent: string;
  publishedAt: Date | string;
  finalScore?: number;
  heroImage?: string;
}
const { href, title, description, intent, publishedAt, finalScore, heroImage } = Astro.props;
const pub = typeof publishedAt === 'string' ? new Date(publishedAt) : publishedAt;
const intentLabels: Record<string, Record<string, string>> = {
  fr: { avis: 'Test', comparatif: 'Comparatif', guide: 'Guide', informational: 'Article' },
  us: { avis: 'Review', comparatif: 'Roundup', guide: 'Guide', informational: 'Article' },
  gb: { avis: 'Review', comparatif: 'Comparison', guide: 'Guide', informational: 'Article' },
};
const intentLabel = intentLabels[siteConfig.market]?.[intent] ?? 'Article';
const dateLocale = siteConfig.locale ?? 'fr-FR';
---
<a href={href} class="block rounded-lg border border-[var(--color-border)] bg-white p-5 shadow-sm hover:shadow-md transition-shadow no-underline">
  {heroImage && <img src={heroImage} alt="" class="w-full aspect-[16/9] object-cover rounded-md mb-3" loading="lazy" />}
  <div class="flex items-center justify-between text-xs uppercase tracking-wide text-[var(--color-primary)] font-semibold mb-2">
    <span>{intentLabel}</span>
    <time datetime={pub.toISOString()}>{pub.toLocaleDateString(dateLocale)}</time>
  </div>
  <h3 class="text-lg font-semibold text-[var(--color-primary-dark)] m-0">{title}</h3>
  <p class="mt-2 text-sm text-[var(--color-text-muted)]">{description}</p>
  {finalScore !== undefined && (
    <p class="mt-3 text-sm"><strong>{s.scoreLabel}: {finalScore}/10</strong></p>
  )}
</a>
