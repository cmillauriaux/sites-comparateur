---
/**
 * Layout for hub (pillar) landing pages (e.g. /jardin/). Renders the
 * hand-authored editorial body, an auto-built grid of the hub's satellite
 * pages, an optional related-blog mesh, optional FAQ + sources, and a
 * Home → Hub breadcrumb (JSON-LD + visible).
 */
import { getCollection } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SourceList from '../components/SourceList.astro';
import siteConfig from 'virtual:site-config';
import { i18n } from '@comparateur/config';
const s = i18n(siteConfig.market);

const { hub } = Astro.props;
const data = hub.data;
const baseUrl = `https://${siteConfig.domain}`;
const hubUrl = `${baseUrl}/${data.slug}/`;

// Satellite cards belonging to this hub, ordered by `order` then title.
const allSats = await getCollection('satellites', ({ data: d }) => !d.draft && d.hub === data.slug);
allSats.sort((a, b) => (a.data.order - b.data.order) || a.data.title.localeCompare(b.data.title));
const satCards = allSats.map(sat => ({
  href: `/${sat.data.hub}/${sat.data.slug ?? sat.id}/`,
  title: sat.data.title,
  description: sat.data.description,
  intent: sat.data.intent,
  publishedAt: sat.data.publishedAt,
  heroImage: sat.data.heroImage,
  heroImageAlt: sat.data.heroImageAlt,
}));

// Related blog articles for the mesh (optional).
const relatedIds: string[] = data.relatedArticles ?? [];
let relatedArticles: { href: string; title: string; description: string; intent: string; publishedAt: Date; heroImage?: string; heroImageAlt?: string }[] = [];
if (relatedIds.length) {
  const segByIntent: Record<string, string> = {
    comparatif: s.slugComparisons, avis: s.slugReviews, guide: s.slugGuides, informational: s.slugGuides,
  };
  const arts = await getCollection('articles', ({ data: d }) => !d.draft);
  relatedArticles = relatedIds
    .map(id => arts.find(a => a.id === id))
    .filter((a): a is NonNullable<typeof a> => Boolean(a))
    .map(a => ({
      href: `/${segByIntent[a.data.intent] ?? s.slugGuides}/${a.id}/`,
      title: a.data.title, description: a.data.description, intent: a.data.intent,
      publishedAt: a.data.publishedAt, heroImage: a.data.heroImage, heroImageAlt: a.data.heroImageAlt,
    }));
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.home, item: `${baseUrl}/` },
    { '@type': 'ListItem', position: 2, name: data.title, item: hubUrl },
  ],
};
const faqSchema = (Array.isArray(data.faq) && data.faq.length > 0) ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map(({ q, a }: { q: string; a: string }) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
} : null;
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: data.title,
  description: data.description,
  url: hubUrl,
  inLanguage: siteConfig.locale ?? 'fr-FR',
};
---
<SiteLayout title={data.title} description={data.description} ogImage={data.heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <section class="bg-[var(--color-hero-bg)] py-12">
    <div class="mx-auto max-w-[var(--max-w-page)] px-4">
      <nav class="text-xs text-[var(--color-text-muted)] mb-3" aria-label="Breadcrumb">
        <a href="/" class="hover:underline">{s.home}</a><span> / </span><span>{data.title}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-3">{data.title}</h1>
      {data.intro && <p class="text-lg text-[var(--color-text-muted)] max-w-3xl">{data.intro}</p>}
      {data.heroImage && (
        <img
          src={data.heroImage}
          alt={data.heroImageAlt ?? data.title}
          class="mt-6 w-full aspect-[21/9] object-cover rounded-lg"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}
    </div>
  </section>

  <div class="mx-auto max-w-[var(--max-w-page)] px-4 py-10">
    <div class="prose prose-lg max-w-none mb-10">
      <slot />
    </div>

    {satCards.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-[var(--color-primary-dark)] mb-6">{s.allComparisons}</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {satCards.map(c => (
            <ArticleCard href={c.href} title={c.title} description={c.description} intent={c.intent}
              publishedAt={c.publishedAt} heroImage={c.heroImage} heroImageAlt={c.heroImageAlt} />
          ))}
        </div>
      </section>
    )}

    {relatedArticles.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-[var(--color-primary-dark)] mb-6">{s.sectionGuides}</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedArticles.map(c => (
            <ArticleCard href={c.href} title={c.title} description={c.description} intent={c.intent}
              publishedAt={c.publishedAt} heroImage={c.heroImage} heroImageAlt={c.heroImageAlt} />
          ))}
        </div>
      </section>
    )}

    {data.faq?.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-[var(--color-primary-dark)] mb-6">{s.faqHeading}</h2>
        <dl class="space-y-4 max-w-3xl">
          {data.faq.map((item: { q: string; a: string }) => (
            <div class="rounded-lg border border-[var(--color-border)] p-4">
              <dt class="font-semibold text-[var(--color-text)] m-0">{item.q}</dt>
              <dd class="text-[var(--color-text-muted)] mt-2 m-0">{item.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {data.sources?.length > 0 && <SourceList sources={data.sources} />}
  </div>
</SiteLayout>
