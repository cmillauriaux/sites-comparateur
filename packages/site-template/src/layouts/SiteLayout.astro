---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UmamiAnalytics from '../components/UmamiAnalytics.astro';
import siteConfig from 'virtual:site-config';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, canonicalPath = Astro.url.pathname, ogImage, noindex = false } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site).toString();
const fullTitle = title.endsWith(siteConfig.name) ? title : `${title} — ${siteConfig.name}`;

// Site-wide default OG image for social/AI previews when a page doesn't
// pass its own (home, hub pages). Per-article pages keep passing their
// hero image via the ogImage prop. open-graph.webp lives in /public.
const resolvedOgImage = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : new URL('/open-graph.webp', Astro.site).toString();

const umamiHost = ((siteConfig as { umami?: { host?: string } }).umami?.host ?? '').replace(/\/$/, '');

// Locale propagated from site.config.js so US/GB sites don't ship `lang="fr"`.
// `locale` is "fr-FR" / "en-US" / "en-GB"; HTML wants the language code only,
// while OpenGraph wants the underscore form.
const siteLocale: string = siteConfig.locale ?? 'fr-FR';
const htmlLang = siteLocale.split('-')[0];
const ogLocale = siteLocale.replace('-', '_');

// Hreflang on the home page only — inner article pages don't have validated
// cross-market equivalents (no translation map yet). x-default points at the
// FR site when present, otherwise the first sibling, so Google has a fallback
// for unmapped locales.
const isHome = canonicalPath === '/' || canonicalPath === '';
const siblings = (siteConfig.hreflangSiblings ?? []) as Array<{ market: string; locale: string; domain: string }>;
const xDefault = siblings.find(s => s.market === 'fr') ?? siblings[0] ?? null;

// Per-site theme: emit CSS variables + load the configured fonts. Falls
// back to the global.css defaults when a site hasn't enriched its theme
// block yet (e.g. sites scaffolded before this refactor).
const theme = siteConfig.theme;
const palette = theme?.palette;
const typography = theme?.typography;
const density = theme?.density;

// bunny.net Fonts — Google Fonts-compatible API without third-party cookies.
// Skipped when typography is absent (theme not enriched) to avoid a 404
// stylesheet request.
const fontsHref = typography
  ? `https://fonts.bunny.net/css?family=${encodeURIComponent(typography.headingFont)}:wght@${typography.headingWeight ?? 700}|${encodeURIComponent(typography.bodyFont)}:wght@${typography.bodyWeight ?? 400}&display=swap`
  : null;

const themeCss = [
  palette && `--color-primary: ${palette.primary};`,
  palette && `--color-primary-dark: ${palette.primaryDark};`,
  palette && `--color-accent: ${palette.accent};`,
  palette && `--color-accent-light: ${palette.accentLight};`,
  palette && `--color-hero-bg: ${palette.heroBg};`,
  palette && `--color-text: ${palette.text};`,
  palette && `--color-text-muted: ${palette.textMuted};`,
  palette && `--color-border: ${palette.border};`,
  density && `--radius: ${density.radius};`,
  density && `--spacing-scale: ${density.spacingScale};`,
  density && `--max-w-prose: ${density.contentMaxWidth};`,
  typography && `--font-heading: "${typography.headingFont}", ui-serif, Georgia, serif;`,
  typography && `--font-body: "${typography.bodyFont}", ui-sans-serif, system-ui, sans-serif;`,
].filter(Boolean).join(' ');
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex,nofollow" />
      : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
    {isHome && siblings.map(s => (
      <link rel="alternate" hreflang={s.locale} href={`https://${s.domain}/`} />
    ))}
    {isHome && xDefault && (
      <link rel="alternate" hreflang="x-default" href={`https://${xDefault.domain}/`} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} — RSS`} href="/rss.xml" />
    {umamiHost && <link rel="preconnect" href={umamiHost} crossorigin />}
    {fontsHref && <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />}
    {fontsHref && <link rel="stylesheet" href={fontsHref} />}
    {themeCss && <style set:html={`:root { ${themeCss} }`} is:inline />}
    <UmamiAnalytics />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
