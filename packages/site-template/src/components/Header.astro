---
import siteConfig from 'virtual:site-config';
import { i18n } from '@comparateur/config';
import Logo from './Logo.astro';
const s = i18n(siteConfig.market);

// Hub-driven sites (e.g. a hub niche) surface their hubs in the nav instead of the
// generic intent links. Sites without `hubs` keep the original intent nav,
// byte-for-byte unchanged.
const hubs = (siteConfig as { hubs?: { slug: string; label: string }[] }).hubs ?? [];
const hasTools = (siteConfig as { hasTools?: boolean }).hasTools === true;

const navItems = hubs.length > 0
  ? [
      { label: s.home, href: '/', hideOnMobile: true },
      ...hubs.map(h => ({ label: h.label, href: `/${h.slug}/` })),
      { label: s.navGuides, href: `/${s.slugGuides}/` },
      ...(hasTools ? [{ label: s.navTools, href: '/outils/' }] : []),
    ]
  : [
      { label: s.home,           href: '/',                       hideOnMobile: true },
      { label: s.navReviews,     href: `/${s.slugReviews}/` },
      { label: s.navComparisons, href: `/${s.slugComparisons}/` },
      { label: s.navGuides,      href: `/${s.slugGuides}/` },
      ...(hasTools ? [{ label: s.navTools, href: '/outils/' }] : []),
    ];
---
<header class="border-b border-[var(--color-border)] bg-white sticky top-0 z-30 backdrop-blur supports-[backdrop-filter]:bg-white/85">
  <div class="mx-auto max-w-[var(--max-w-page)] px-4 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-semibold text-lg text-[var(--color-primary-dark)]">
      <Logo class="h-7 w-7" />
      <span>{siteConfig.name}</span>
    </a>
    <nav class="flex items-center gap-6 text-sm overflow-x-auto whitespace-nowrap">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors",
            item.hideOnMobile && "hidden sm:inline",
          ]}
        >{item.label}</a>
      ))}
    </nav>
  </div>
</header>
