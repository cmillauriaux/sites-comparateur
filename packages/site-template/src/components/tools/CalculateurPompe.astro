---
/**
 * CalculateurPompe.astro
 * Calculateur de Hauteur Manométrique Totale (HMT), débit et puissance de pompe à eau.
 * Alerte automatique sur l'aspiration physique > 7m (immergée obligatoire).
 */
---

<div class="calculateur-pompe-container my-8 p-6 md:p-8 border border-[var(--color-border)] rounded-lg bg-white shadow-sm" id="calc-pompe-container">
  <div class="border-b border-[var(--color-border)] pb-4 mb-6">
    <h3 class="text-xl md:text-2xl font-bold text-[var(--color-primary-dark)] flex items-center gap-2">
      ⚡ Calculateur de Puissance & HMT de Pompe d'Arrosage
    </h3>
    <p class="text-sm text-[var(--color-text-muted)] mt-1">
      Déterminez le débit, les pertes de charge et la Hauteur Manométrique Totale (HMT) nécessaires pour votre installation afin de choisir la pompe idéale.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Formulaire (Saisies) -->
    <div class="lg:col-span-5 space-y-4">
      
      <!-- Profondeur d'aspiration -->
      <div>
        <label for="pompe-profondeur" class="block text-sm font-semibold text-[var(--color-text)] mb-1">
          Profondeur d'aspiration (m)
        </label>
        <div class="relative">
          <input 
            type="number" 
            id="pompe-profondeur" 
            min="0" 
            max="100" 
            value="4"
            class="w-full pl-3 pr-12 py-2 border border-[var(--color-border)] rounded-md text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent" 
          />
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-[var(--color-text-muted)]">
            m
          </div>
        </div>
        <p class="text-xs text-[var(--color-text-muted)] mt-1">
          Distance verticale entre la pompe et le niveau de l'eau dans le puits.
        </p>
      </div>

      <!-- Dénivelé vertical du refoulement -->
      <div>
        <label for="pompe-denivele" class="block text-sm font-semibold text-[var(--color-text)] mb-1">
          Dénivelé vertical au refoulement (m)
        </label>
        <div class="relative">
          <input 
            type="number" 
            id="pompe-denivele" 
            min="0" 
            max="100" 
            value="3"
            class="w-full pl-3 pr-12 py-2 border border-[var(--color-border)] rounded-md text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent" 
          />
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-[var(--color-text-muted)]">
            m
          </div>
        </div>
        <p class="text-xs text-[var(--color-text-muted)] mt-1">
          Hauteur entre la pompe et le point de sortie de l'eau le plus haut.
        </p>
      </div>

      <!-- Longueur du tuyau de refoulement -->
      <div>
        <label for="pompe-longueur" class="block text-sm font-semibold text-[var(--color-text)] mb-1">
          Longueur totale du tuyau de refoulement (m)
        </label>
        <div class="relative">
          <input 
            type="number" 
            id="pompe-longueur" 
            min="0" 
            max="500" 
            value="25"
            class="w-full pl-3 pr-12 py-2 border border-[var(--color-border)] rounded-md text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent" 
          />
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-[var(--color-text-muted)]">
            m
          </div>
        </div>
        <p class="text-xs text-[var(--color-text-muted)] mt-1">
          Longueur à plat de votre tuyauterie d'arrosage. Engendre des frottements (pertes de charge).
        </p>
      </div>

      <!-- Nombre d'arroseurs -->
      <div>
        <label for="pompe-arroseurs" class="block text-sm font-semibold text-[var(--color-text)] mb-1">
          Nombre d'arroseurs raccordés simultanément
        </label>
        <div class="relative">
          <input 
            type="number" 
            id="pompe-arroseurs" 
            min="1" 
            max="50" 
            value="3"
            class="w-full pl-3 pr-12 py-2 border border-[var(--color-border)] rounded-md text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent" 
          />
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-[var(--color-text-muted)]">
            pcs
          </div>
        </div>
        <p class="text-xs text-[var(--color-text-muted)] mt-1">
          Base d'estimation : 600 L/h par tuyau d'arrosage/arroseur oscillant standard.
        </p>
      </div>

      <!-- Pression de fonctionnement souhaitée -->
      <div>
        <label for="pompe-pression" class="block text-sm font-semibold text-[var(--color-text)] mb-1">
          Pression de sortie souhaitée
        </label>
        <select 
          id="pompe-pression" 
          class="w-full px-3 py-2 border border-[var(--color-border)] rounded-md text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent"
        >
          <option value="2">2.0 bars (Standard — Goutte à goutte, tuyau poreux)</option>
          <option value="2.5" selected>2.5 bars (Recommandé — Arroseur de surface, pelouse)</option>
          <option value="3">3.0 bars (Pression forte — Arroseurs oscillants multiples / turbine)</option>
        </select>
      </div>

    </div>

    <!-- Résultats techniques -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-slate-50 p-6 rounded-lg border border-[var(--color-border)] space-y-6">
        <h4 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-muted)] border-b border-[var(--color-border)] pb-2">
          📊 Spécifications requises calculées
        </h4>

        <!-- Grille de résultats chiffrés -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <!-- HMT -->
          <div class="bg-white p-4 rounded-md border border-[var(--color-border)]">
            <span class="block text-xs text-[var(--color-text-muted)] font-medium">Hauteur Manométrique Totale (HMT) :</span>
            <span id="pompe-result-hmt" class="text-2xl font-extrabold text-[var(--color-primary)]">34.9</span>
            <span class="text-sm font-bold text-[var(--color-primary)]"> mètres</span>
            <p class="text-[10px] text-[var(--color-text-muted)] mt-1">
              Pression équivalente requise en sortie de pompe (pertes de charge incluses).
            </p>
          </div>

          <!-- Débit Requis -->
          <div class="bg-white p-4 rounded-md border border-[var(--color-border)]">
            <span class="block text-xs text-[var(--color-text-muted)] font-medium">Débit requis de la pompe :</span>
            <span id="pompe-result-debit" class="text-2xl font-extrabold text-blue-600">1 800 L/h</span>
            <span id="pompe-result-debit-m3" class="block text-[11px] font-semibold text-blue-500 mt-1">soit 1.80 m³/h</span>
          </div>

        </div>

        <!-- Alerte type de pompe (Règle des 7-8m) -->
        <div id="pompe-type-alert" class="p-4 rounded-md border transition-colors duration-150">
          <h5 id="pompe-alert-title" class="font-bold text-sm mb-1">...</h5>
          <p id="pompe-alert-desc" class="text-xs leading-relaxed">...</p>
        </div>

        <!-- Puissance en Watts -->
        <div class="p-4 rounded-md border border-amber-200 bg-amber-50/50 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
          <div>
            <h5 class="font-bold text-sm text-amber-900 flex items-center gap-1.5">
              🔌 Puissance moteur recommandée :
            </h5>
            <p class="text-xs text-amber-800 leading-relaxed mt-0.5">
              Estime la puissance électrique brute nécessaire pour générer la HMT et le débit calculés.
            </p>
          </div>
          <div class="bg-white px-4 py-2 rounded border border-amber-200 text-center self-stretch md:self-auto flex items-center justify-center">
            <span id="pompe-result-watts" class="text-xl font-extrabold text-amber-700">800 W</span>
          </div>
        </div>

      </div>

      <!-- Notice explicative rapide -->
      <div class="p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 leading-relaxed space-y-2">
        <p>
          <strong>💡 Comment lisons-nous ces résultats ?</strong>
          La HMT est la pression réelle totale que la pompe doit fournir. Les fabricants de pompes fournissent une <strong>courbe de performance</strong>. Ne prenez pas une pompe dont le maximum est égal à votre HMT ! La pompe doit pouvoir assurer votre débit requis (ex: 1.8 m³/h) <em>à</em> la hauteur HMT calculée.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  function initPompeCalculator() {
    const profondeurInput = document.getElementById('pompe-profondeur') as HTMLInputElement | null;
    const deniveleInput = document.getElementById('pompe-denivele') as HTMLInputElement | null;
    const longueurInput = document.getElementById('pompe-longueur') as HTMLInputElement | null;
    const arroseursInput = document.getElementById('pompe-arroseurs') as HTMLInputElement | null;
    const pressionSelect = document.getElementById('pompe-pression') as HTMLSelectElement | null;

    const resultHmt = document.getElementById('pompe-result-hmt');
    const resultDebit = document.getElementById('pompe-result-debit');
    const resultDebitM3 = document.getElementById('pompe-result-debit-m3');
    const resultWatts = document.getElementById('pompe-result-watts');

    const alertBox = document.getElementById('pompe-type-alert');
    const alertTitle = document.getElementById('pompe-alert-title');
    const alertDesc = document.getElementById('pompe-alert-desc');

    if (!profondeurInput || !deniveleInput || !longueurInput || !arroseursInput || !pressionSelect) return;

    profondeurInput.addEventListener('input', calculate);
    deniveleInput.addEventListener('input', calculate);
    longueurInput.addEventListener('input', calculate);
    arroseursInput.addEventListener('input', calculate);
    pressionSelect.addEventListener('change', calculate);

    function calculate() {
      const prof = parseFloat(profondeurInput?.value || '0');
      const deniv = parseFloat(deniveleInput?.value || '0');
      const long = parseFloat(longueurInput?.value || '0');
      const nArroseurs = parseInt(arroseursInput?.value || '1', 10);
      const press = parseFloat(pressionSelect?.value || '2.5');

      // 1. Débit requis
      const debitLh = nArroseurs * 600;
      const debitM3h = debitLh / 1000;

      // 2. Pertes de charge (10% de la longueur d'aspiration + refoulement)
      const pertes = (prof + long) * 0.1;

      // 3. HMT = Profondeur + Dénivelé + Pertes de charge + (Pression d'utilisation * 10)
      // Note : 1 bar = 10 mètres de colonne d'eau (CE)
      const hmt = prof + deniv + pertes + (press * 10);

      // Mettre à jour l'affichage de HMT et Débit
      if (resultHmt) resultHmt.textContent = hmt.toFixed(1);
      if (resultDebit) resultDebit.textContent = debitLh.toLocaleString('fr-FR') + ' L/h';
      if (resultDebitM3) resultDebitM3.textContent = `soit ${debitM3h.toFixed(2)} m³/h`;

      // 4. Choix de type de pompe : Règle d'or de la physique
      if (alertBox && alertTitle && alertDesc) {
        if (prof > 7) {
          // Rouge : Pompe immergée obligatoire !
          alertBox.className = "p-4 rounded-md border border-red-200 bg-red-50 text-red-800 transition-colors duration-150";
          alertTitle.textContent = "🚨 Pompe immergée OBLIGATOIRE !";
          alertDesc.textContent = `Votre profondeur d'aspiration (${prof} m) dépasse la limite physique absolue d'aspiration de 7 à 8 mètres de l'eau par le vide (pression atmosphérique). Une pompe de surface désamorcera immédiatement et ne pourra jamais puiser l'eau. Vous devez obligatoirement utiliser une pompe de puits ou de forage immergée.`;
        } else {
          // Vert : Pompe de surface ou immergée adaptée
          alertBox.className = "p-4 rounded-md border border-emerald-200 bg-emerald-50 text-emerald-800 transition-colors duration-150";
          alertTitle.textContent = "✅ Pompe de surface ou immergée possible";
          alertDesc.textContent = `Avec une profondeur d'aspiration de ${prof} m (inférieure à 7 mètres), vous avez le choix. Une pompe de surface (plus économique) convient parfaitement. Une pompe immergée reste une excellente alternative pour éliminer les nuisances sonores dans le jardin.`;
        }
      }

      // 5. Puissance en Watts estimée
      // Approximation standard de puissance requise par rapport à la HMT
      let watts = 400;
      if (hmt < 20) {
        watts = 400;
      } else if (hmt < 40) {
        watts = 800;
      } else {
        watts = 1100;
      }

      // Si le débit est très élevé, on augmente d'un cran
      if (debitLh > 3000 && watts < 1100) {
        watts = 1100;
      } else if (debitLh > 4500) {
        watts = 1500;
      }

      if (resultWatts) {
        resultWatts.textContent = `${watts} W`;
      }
    }

    // Calcul initial
    calculate();
  }

  document.addEventListener('DOMContentLoaded', initPompeCalculator);
  document.addEventListener('astro:page-load', initPompeCalculator);
</script>
