  const moisOptionnels = [
    'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'
  ];

  function initCalendrierSemis() {
    const deptSelect = document.getElementById('semis-dept-select') as HTMLSelectElement | null;
    const infoClimat = document.getElementById('semis-info-climat');
    const dateGel = document.getElementById('semis-date-gel');
    const tableBody = document.getElementById('semis-table-body');

    if (!deptSelect || !tableBody) return;

    deptSelect.addEventListener('change', () => {
      const zone = deptSelect.value;
      const data = calendarData[zone];

      if (!data) return;

      // Afficher les infos climatiques
      if (infoClimat && dateGel) {
        infoClimat.classList.remove('hidden');
        dateGel.textContent = data.gel;
      }

      // Re-générer le tableau
      tableBody.innerHTML = '';

      Object.entries(data.cultures).forEach(([key, crop]) => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition-colors";

        // Colonne Nom culture
        const tdName = document.createElement('td');
        tdName.className = "p-3 font-semibold text-slate-900 border-r border-slate-100 flex items-center gap-2";
        tdName.innerHTML = `<span class="text-lg">${crop.emoji}</span> <span>${crop.label}</span>`;
        tr.appendChild(tdName);

        // Colonnes des mois
        moisOptionnels.forEach(m => {
          const tdMonth = document.createElement('td');
          tdMonth.className = "p-1 text-center align-middle border-r border-slate-100 last:border-r-0";

          const isAbri = crop.abri.includes(m);
          const isTerre = crop.terre.includes(m);
          const isPlant = crop.plant.includes(m);
          const isRecolte = crop.recolte.includes(m);

          let badge = null;

          if (isAbri) {
            badge = document.createElement('span');
            badge.className = "block py-1 rounded bg-amber-200 border border-amber-300 text-amber-900 font-bold text-[10px]";
            badge.textContent = "S";
            badge.title = "Semis sous abri (serre, châssis ou intérieur)";
          } else if (isTerre) {
            badge = document.createElement('span');
            badge.className = "block py-1 rounded bg-emerald-100 border border-emerald-300 text-emerald-900 font-bold text-[10px]";
            badge.textContent = "T";
            badge.title = "Semis direct en pleine terre";
          } else if (isPlant) {
            badge = document.createElement('span');
            badge.className = "block py-1 rounded bg-emerald-500 border border-emerald-600 text-white font-bold text-[10px]";
            badge.textContent = "P";
            badge.title = "Plantation / Repiquage de jeunes plants";
          } else if (isRecolte) {
            badge = document.createElement('span');
            badge.className = "block py-1 rounded bg-orange-400 border border-orange-500 text-white font-bold text-[10px]";
            badge.textContent = "R";
            badge.title = "Période de récolte";
          }

          if (badge) {
            tdMonth.appendChild(badge);
          } else {
            tdMonth.className += " opacity-25";
          }

          tr.appendChild(tdMonth);
        });

        tableBody.appendChild(tr);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCalendrierSemis);
  document.addEventListener('astro:page-load', initCalendrierSemis);
</script>
