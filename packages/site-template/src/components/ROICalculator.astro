---
/**
 * Calculateur de rentabilité solaire — vanilla JS, zéro îlot framework.
 * Multi-instance : le <script> (bundlé une fois) initialise chaque
 * `.roi-calc` indépendamment via ses data-attributs + inputs internes.
 *
 * Les valeurs par défaut sont des hypothèses ÉDITABLES (pas des faits) :
 * l'utilisateur les ajuste, le résultat se recalcule en direct. La
 * production par kWc (~900–1100 kWh/kWc/an en France métropolitaine selon
 * l'exposition — ordre de grandeur ADEME / photovoltaique.info) est exposée
 * comme champ modifiable plutôt que figée dans le texte.
 */
interface Props {
  title?: string;
  puissanceKwc?: number;       // puissance installée par défaut
  coutInstallation?: number;   // coût total TTC par défaut (€)
  aides?: number;              // aides déduites par défaut (€)
  prixKwh?: number;            // prix du kWh acheté au réseau (€)
  autoconsommation?: number;   // part autoconsommée (0–100)
  productionParKwc?: number;   // kWh/kWc/an (hypothèse éditable)
}
const {
  title = 'Calculateur de rentabilité',
  puissanceKwc = 3,
  coutInstallation = 7000,
  aides = 0,
  prixKwh = 0.25,
  autoconsommation = 70,
  productionParKwc = 1000,
} = Astro.props;
---
<div
  class="roi-calc not-prose my-8 rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-hero-bg)] p-5 sm:p-6"
  data-prod-kwc={productionParKwc}
>
  <h3 class="mt-0 mb-1 font-[var(--font-heading)] text-lg font-bold text-[var(--color-text)]">{title}</h3>
  <p class="mb-4 text-sm text-[var(--color-text-muted)]">
    Estimation indicative. Ajustez les hypothèses à votre situation : les chiffres ci-dessous sont
    des ordres de grandeur, pas une garantie de rendement.
  </p>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1 text-sm font-medium text-[var(--color-text)]">
      Puissance installée (kWc)
      <input type="number" min="0" step="0.1" value={puissanceKwc} data-field="puissance"
        class="roi-in rounded-[var(--radius)] border border-[var(--color-border)] bg-white px-3 py-2 text-base" />
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-[var(--color-text)]">
      Coût total de l'installation (€ TTC)
      <input type="number" min="0" step="100" value={coutInstallation} data-field="cout"
        class="roi-in rounded-[var(--radius)] border border-[var(--color-border)] bg-white px-3 py-2 text-base" />
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-[var(--color-text)]">
      Aides déduites (€)
      <input type="number" min="0" step="100" value={aides} data-field="aides"
        class="roi-in rounded-[var(--radius)] border border-[var(--color-border)] bg-white px-3 py-2 text-base" />
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-[var(--color-text)]">
      Prix du kWh acheté au réseau (€)
      <input type="number" min="0" step="0.01" value={prixKwh} data-field="prix"
        class="roi-in rounded-[var(--radius)] border border-[var(--color-border)] bg-white px-3 py-2 text-base" />
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-[var(--color-text)]">
      Part autoconsommée (%)
      <input type="number" min="0" max="100" step="5" value={autoconsommation} data-field="autoconso"
        class="roi-in rounded-[var(--radius)] border border-[var(--color-border)] bg-white px-3 py-2 text-base" />
    </label>
    <label class="flex flex-col gap-1 text-sm font-medium text-[var(--color-text)]">
      Production (kWh/kWc/an)
      <input type="number" min="0" step="50" value={productionParKwc} data-field="prod"
        class="roi-in rounded-[var(--radius)] border border-[var(--color-border)] bg-white px-3 py-2 text-base" />
    </label>
  </div>

  <dl class="mt-5 grid grid-cols-1 gap-3 border-t border-[var(--color-border)] pt-4 sm:grid-cols-3">
    <div class="rounded-[var(--radius)] bg-white p-3 text-center">
      <dt class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-muted)]">Économie / an</dt>
      <dd class="mt-1 text-xl font-bold text-[var(--color-primary)]" data-out="economie">—</dd>
    </div>
    <div class="rounded-[var(--radius)] bg-white p-3 text-center">
      <dt class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-muted)]">Temps de retour</dt>
      <dd class="mt-1 text-xl font-bold text-[var(--color-primary)]" data-out="retour">—</dd>
    </div>
    <div class="rounded-[var(--radius)] bg-white p-3 text-center">
      <dt class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-muted)]">Gain net sur 20 ans</dt>
      <dd class="mt-1 text-xl font-bold text-[var(--color-primary)]" data-out="gain20">—</dd>
    </div>
  </dl>
</div>

<script>
  function initRoiCalc(root: HTMLElement) {
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('.roi-in'));
    const out = (key: string) => root.querySelector<HTMLElement>(`[data-out="${key}"]`);
    const eur = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

    const num = (field: string) => {
      const el = root.querySelector<HTMLInputElement>(`[data-field="${field}"]`);
      const v = el ? parseFloat(el.value) : NaN;
      return Number.isFinite(v) ? v : 0;
    };

    function recompute() {
      const puissance = num('puissance');
      const cout = num('cout');
      const aides = num('aides');
      const prix = num('prix');
      const autoconso = Math.min(Math.max(num('autoconso'), 0), 100) / 100;
      const prod = num('prod');

      const productionAnnuelle = puissance * prod;            // kWh/an
      const economieAnnuelle = productionAnnuelle * autoconso * prix; // €/an
      const investissementNet = Math.max(cout - aides, 0);    // €
      const gain20 = economieAnnuelle * 20 - investissementNet;

      const eEco = out('economie');
      const eRet = out('retour');
      const eGain = out('gain20');
      if (eEco) eEco.textContent = eur.format(economieAnnuelle);
      if (eRet) {
        eRet.textContent = economieAnnuelle > 0
          ? `${(investissementNet / economieAnnuelle).toFixed(1)} ans`
          : '—';
      }
      if (eGain) eGain.textContent = eur.format(gain20);
    }

    inputs.forEach((el) => el.addEventListener('input', recompute));
    recompute();
  }

  document.querySelectorAll<HTMLElement>('.roi-calc').forEach(initRoiCalc);
</script>
