---
import siteConfig from 'virtual:site-config';
import { i18n } from '@comparateur/config';
const s = i18n(siteConfig.market);
const year = new Date().getFullYear();
const slugs = s.legalSlugs;
---
<footer class="mt-20 border-t border-[var(--color-border)] bg-[var(--color-hero-bg)]">
  <div class="mx-auto max-w-[var(--max-w-page)] px-4 py-10 text-sm text-[var(--color-text-muted)] grid gap-6 md:grid-cols-3">
    <div>
      <p class="font-semibold text-[var(--color-primary-dark)] mb-2">{siteConfig.name}</p>
      <p>{siteConfig.shortDescription}</p>
    </div>
    <div>
      <p class="font-semibold text-[var(--color-primary-dark)] mb-2">{s.navigation}</p>
      <ul class="space-y-1">
        <li><a href={`/${s.slugReviews}/`}>{s.navReviews}</a></li>
        <li><a href={`/${s.slugComparisons}/`}>{s.navComparisons}</a></li>
        <li><a href={`/${s.slugGuides}/`}>{s.navGuides}</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-[var(--color-primary-dark)] mb-2">{s.information}</p>
      <ul class="space-y-1">
        <li><a href={`/${slugs.methodology}/`}>{s.methodologyLink}</a></li>
        <li><a href={`/${slugs.legal}/`}>{s.legalNotice}</a></li>
        <li><a href={`/${slugs.privacy}/`}>{s.privacyPolicy}</a></li>
        <li><a href={`/${slugs.affiliate}/`}>{s.affiliatePolicy}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[var(--color-border)] py-4 text-xs text-center text-[var(--color-text-muted)]">
    © {year} {siteConfig.name} — {siteConfig.domain}. {s.footerTagline}
  </div>
</footer>
