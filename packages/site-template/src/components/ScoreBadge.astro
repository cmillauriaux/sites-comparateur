---
import siteConfig from 'virtual:site-config';
import { i18n } from '@comparateur/config';
const t = i18n(siteConfig.market);

interface Props {
  score: number; // 0–10
  label?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { score, label, size = 'md' } = Astro.props;
const rounded = Math.round(score * 10) / 10;
const color = score >= 8 ? 'var(--color-good)' : score >= 6 ? 'var(--color-warn)' : 'var(--color-bad)';
const sizes = {
  sm: { box: 'h-10 w-12 text-base', label: 'text-xs' },
  md: { box: 'h-14 w-16 text-xl', label: 'text-sm' },
  lg: { box: 'h-20 w-24 text-3xl', label: 'text-base' },
};
const s = sizes[size];
---
<div class="inline-flex items-center gap-3 align-middle">
  <div
    class:list={["flex flex-col items-center justify-center rounded-lg font-bold text-white shadow-sm", s.box]}
    style={`background-color: ${color}`}
    aria-label={t.scoreAria(rounded)}
  >
    <span>{rounded}</span>
    <span class="text-[0.6em] font-normal opacity-90">/10</span>
  </div>
  {label && <span class:list={["text-[var(--color-text-muted)]", s.label]}>{label}</span>}
</div>
