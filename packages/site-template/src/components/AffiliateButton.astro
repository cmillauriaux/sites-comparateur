---
/**
 * Bouton CTA d'affiliation. Construit le href automatiquement quand `product`
 * est fourni et qu'aucun href n'est passé : URL Amazon de la marketplace du
 * site (lu depuis site.config.js) avec ASIN + tag + paramètres SiteStripe.
 *
 * Awin est désactivé tant qu'aucun ID Awin n'est configuré dans .env. Si
 * `program="awin-..."` est passé sans advertiserId, on retombe sur Amazon.
 */
import { buildAmazonUrl } from '@comparateur/config/affiliate';
import { i18n } from '@comparateur/config';
import siteConfig from 'virtual:site-config';

interface Props {
  href?: string;
  product?: string;
  asin?: string;
  program?: string;
  variant?: 'primary' | 'secondary';
}
const market: 'fr' | 'us' | 'gb' = siteConfig.market;
const { href, product, asin, program = `amazon-${market}`, variant = 'primary' } = Astro.props;

const tagEnvKey = `AMAZON_AFFILIATE_ID_${market.toUpperCase()}`;
const amazonTag = import.meta.env[tagEnvKey] || process.env[tagEnvKey] || '';
const finalHref = href || buildAmazonUrl({ asin, query: product, market, tag: amazonTag });
const label = i18n(market).viewOnAmazon;
---
<a
  href={finalHref}
  rel="sponsored nofollow noopener"
  target="_blank"
  data-affiliate={program}
  data-product={product}
  class:list={[
    "inline-flex items-center gap-2 rounded-md px-5 py-3 font-semibold text-center no-underline transition-colors",
    variant === 'primary'
      ? "bg-[var(--color-primary)] text-white hover:bg-[var(--color-primary-dark)]"
      : "border-2 border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white",
  ]}
>
  <slot>{label}{product ? ` — ${product}` : ''}</slot>
  <span aria-hidden="true">→</span>
</a>
