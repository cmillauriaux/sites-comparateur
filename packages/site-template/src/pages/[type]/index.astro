---
/**
 * Unified listing for the three intent buckets, served at the localised
 * segment of each:  /comparatifs/  /avis/  /guides/  on FR ;
 * /comparisons/   /reviews/   /guides/  on US ;
 * /comparisons/   /reviews/   /guides/  on GB.
 *
 * Replaces six near-identical *index.astro per market.
 */
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import HubLayout from '../../layouts/HubLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import SourceList from '../../components/SourceList.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import siteConfig from 'virtual:site-config';
import { i18n } from '@comparateur/config';

const s = i18n(siteConfig.market);
const mdxComponents = { AffiliateButton, ProductCard, ComparisonTable, ScoreBadge, SourceList, ROICalculator };

type Bucket = 'comparatif' | 'avis' | 'guide';

const buckets: Record<string, { intentMatch: (i: string) => boolean; heading: string; intro?: string; emptyText: string; titleLabel: string; showScore?: boolean }> = {
  [s.slugComparisons]: {
    intentMatch: (i) => i === 'comparatif',
    heading: s.allComparisons,
    intro: s.pageComparisonsIntro,
    emptyText: s.noComparisons,
    titleLabel: s.navComparisons,
  },
  [s.slugReviews]: {
    intentMatch: (i) => i === 'avis',
    heading: s.allReviews,
    intro: s.pageReviewsIntro,
    emptyText: s.noReviews,
    titleLabel: s.navReviews,
    showScore: true,
  },
  [s.slugGuides]: {
    intentMatch: (i) => i === 'guide' || i === 'informational',
    heading: s.allGuides,
    emptyText: s.noGuides,
    titleLabel: s.allGuides,
  },
};

export async function getStaticPaths() {
  const cfg = (await import('virtual:site-config')).default;
  const strings = (await import('@comparateur/config')).i18n(cfg.market);
  // Unique segments — guides slug may equal one of the others on some
  // markets in the future; Set dedupes in that case.
  const segments = [...new Set([strings.slugComparisons, strings.slugReviews, strings.slugGuides])];
  const listingPaths = segments.map(type => ({ params: { type }, props: { kind: 'listing' as const } }));

  // Hub landing pages at /<hub>/ — only when site.config.js declares hubs.
  const hubDefs = (cfg.hubs ?? []) as { slug: string }[];
  let hubPaths: { params: { type: string }; props: { kind: 'hub'; hubSlug: string } }[] = [];
  if (hubDefs.length) {
    const intentSlugs = new Set(segments);
    const allHubs = await getCollection('hubs', ({ data }) => !data.draft);
    hubPaths = allHubs
      .filter(h => !intentSlugs.has(h.data.slug))   // guard: never shadow a listing
      .map(h => ({ params: { type: h.data.slug }, props: { kind: 'hub' as const, hubSlug: h.data.slug } }));
  }
  return [...listingPaths, ...hubPaths];
}

const { type } = Astro.params;
const props = Astro.props as { kind: 'listing' } | { kind: 'hub'; hubSlug: string };

// Hub landing branch — render the pillar page + its authored MDX body.
let hubEntry = null;
let HubContent = null;
if (props.kind === 'hub') {
  const allHubs = await getCollection('hubs', ({ data }) => !data.draft);
  hubEntry = allHubs.find(h => h.data.slug === props.hubSlug) ?? null;
  if (!hubEntry) throw new Error(`No hub entry for slug: ${props.hubSlug}`);
  HubContent = (await render(hubEntry)).Content;
}

const bucket = props.kind === 'listing' ? buckets[type as string] : null;
if (props.kind === 'listing' && !bucket) throw new Error(`No listing bucket for segment: ${type}`);

interface ListCard {
  href: string; title: string; description: string; intent: string;
  publishedAt: Date; heroImage?: string; heroImageAlt?: string; finalScore?: number;
}
let cards: ListCard[] = [];
if (bucket) {
  // CI-generated flat articles for this intent.
  const articles = await getCollection('articles', ({ data }) => !data.draft && bucket.intentMatch(data.intent));
  cards.push(...articles.map(a => ({
    href: `/${type}/${a.id}/`,
    title: a.data.title, description: a.data.description, intent: a.data.intent,
    publishedAt: a.data.publishedAt, heroImage: a.data.heroImage, heroImageAlt: a.data.heroImageAlt,
    finalScore: a.data.finalScore,
  })));
  // Hand-authored hub satellites of the same intent live at /<hub>/<slug>/ but
  // belong in the intent listing too (a buying guide is a buying guide,
  // wherever it sits in the hub tree).
  if ((siteConfig.hubs ?? []).length) {
    const sats = await getCollection('satellites', ({ data }) => !data.draft && bucket.intentMatch(data.intent));
    cards.push(...sats.map(sat => ({
      href: `/${sat.data.hub}/${sat.data.slug ?? sat.id}/`,
      title: sat.data.title, description: sat.data.description, intent: sat.data.intent,
      publishedAt: sat.data.publishedAt, heroImage: sat.data.heroImage, heroImageAlt: sat.data.heroImageAlt,
      finalScore: sat.data.finalScore,
    })));
  }
  cards.sort((a, b) => +b.publishedAt - +a.publishedAt);
}

const description = bucket?.intro ?? siteConfig.shortDescription;
---
{hubEntry && HubContent ? (
  <HubLayout hub={hubEntry}>
    <HubContent components={mdxComponents} />
  </HubLayout>
) : (
<SiteLayout title={bucket!.titleLabel} description={description}>
  <div class="mx-auto max-w-[var(--max-w-page)] px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] mb-6">{bucket!.heading}</h1>
    {bucket!.intro && <p class="text-[var(--color-text-muted)] mb-8 max-w-3xl">{bucket!.intro}</p>}
    {cards.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">{bucket!.emptyText}</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {cards.map((c) => (
          <ArticleCard
            href={c.href}
            title={c.title}
            description={c.description}
            intent={c.intent}
            publishedAt={c.publishedAt}
            heroImage={c.heroImage}
            heroImageAlt={c.heroImageAlt}
            finalScore={bucket!.showScore ? c.finalScore : undefined}
          />
        ))}
      </div>
    )}
  </div>
</SiteLayout>
)}
