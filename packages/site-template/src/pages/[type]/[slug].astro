---
/**
 * Single dynamic route serving every article — comparatif / avis / guide —
 * under their localised path segment ("comparatifs" / "comparisons" /
 * "avis" / "reviews" / "guides"). Replaces three near-identical
 * `<intent>/[...slug].astro` files per market.
 *
 * Mapping (data.intent → URL segment) comes from i18n.js#slug{Comparisons,
 * Reviews,Guides} for the site's market — same source of truth as
 * article-generator.js subdirByIntent.
 */
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SatelliteLayout from '../../layouts/SatelliteLayout.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
// SourceList is normally rendered by the layout (the prompt tells Claude not
// to write it inline), but the model occasionally does anyway — especially on
// guide articles. Expose it via the components map so the build doesn't blow
// up; the duplicate render at most reads as a redundant section, never a
// 500 page.
import SourceList from '../../components/SourceList.astro';
import ROICalculator from '../../components/ROICalculator.astro';

// NOTE: getStaticPaths runs in an isolated scope (Astro hoists it before the
// frontmatter), so the i18n table must be redeclared inside it.
export async function getStaticPaths() {
  const cfg = (await import('virtual:site-config')).default;
  const { i18n } = await import('@comparateur/config');
  const s = i18n(cfg.market);
  const segmentByIntent: Record<string, string> = {
    comparatif:    s.slugComparisons,
    avis:          s.slugReviews,
    guide:         s.slugGuides,
    informational: s.slugGuides,
  };
  const all = await getCollection('articles', ({ data }) => !data.draft);
  const articlePaths = all.map(article => ({
    params: { type: segmentByIntent[article.data.intent] ?? s.slugGuides, slug: article.id },
    props: { kind: 'article' as const, article },
  }));

  // Satellite pages live under their hub slug, e.g. /solaire/kit-solaire/.
  // Only emitted when site.config.js declares hubs — keeps existing sites
  // path-identical (empty union).
  const hubSlugs = new Set<string>((cfg.hubs ?? []).map((h: { slug: string }) => h.slug));
  // Build-time guard: a hub slug must never shadow an intent listing slug.
  const intentSlugs = new Set([s.slugComparisons, s.slugReviews, s.slugGuides]);
  for (const slug of hubSlugs) {
    if (intentSlugs.has(slug)) throw new Error(`Hub slug "${slug}" collides with an intent slug — rename the hub in site.config.js`);
  }
  const sats = hubSlugs.size
    ? await getCollection('satellites', ({ data }) => !data.draft && hubSlugs.has(data.hub))
    : [];
  const satellitePaths = sats.map(sat => ({
    params: { type: sat.data.hub, slug: sat.data.slug ?? sat.id },
    props: { kind: 'satellite' as const, satellite: sat },
  }));

  return [...articlePaths, ...satellitePaths];
}

const { kind } = Astro.props;
const components = { AffiliateButton, ProductCard, ComparisonTable, ScoreBadge, SourceList, ROICalculator };
const entry = kind === 'satellite' ? Astro.props.satellite : Astro.props.article;
const { Content } = await render(entry);
---
{kind === 'satellite' ? (
  <SatelliteLayout entry={entry}>
    <Content components={components} />
  </SatelliteLayout>
) : (
  <ArticleLayout article={entry}>
    <Content components={components} />
  </ArticleLayout>
)}
