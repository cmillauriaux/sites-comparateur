# DataForSEO — https://dataforseo.com (Basic Auth credentials)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Semrush Analytics API — https://www.semrush.com/api-analytics/ (Business plan)
# Used by semrush-prioritize.js to mine Easy/Very-Easy keyword clusters.
# Cost: phrase_fullsearch = 20 API units per row returned. The script caches
# responses in data/semrush-cache/ for 14 days to avoid burning quota.
SEMRUSH_API_KEY=

# Claude Code CLI auth (used by article-generator + GitHub Actions)
# Generated via: `claude` then "Get OAuth token"
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic API key (fallback for direct SDK calls if needed)
ANTHROPIC_API_KEY=

# Affiliation Amazon — one tag per marketplace (separate Associates accounts).
# Format examples: monsite-21 (FR), monsite-20 (US), monsite-21 (UK).
# https://partenaires.amazon.fr / associates.amazon.com / affiliate-program.amazon.co.uk
AMAZON_AFFILIATE_ID_FR=
AMAZON_AFFILIATE_ID_US=
AMAZON_AFFILIATE_ID_GB=

# Affiliation Awin — https://www.awin.com
AWIN_PUBLISHER_ID=
AWIN_LEROY_MERLIN_ID=
AWIN_BOULANGER_ID=
AWIN_DECATHLON_ID=
AWIN_DARTY_ID=
AWIN_FNAC_ID=
AWIN_CASTORAMA_ID=
AWIN_MR_BRICOLAGE_ID=
# General-purpose FR retailers
AWIN_MANOMANO_ID=
AWIN_CDISCOUNT_ID=

# Google Search Console — LOCAL ONLY, and optional.
# CI authenticates via Workload Identity Federation (no key material): the GCP
# org enforces constraints/iam.disableServiceAccountKeyCreation, so a service
# account key cannot be created. Locally, either leave this empty and run
#   gcloud auth application-default login
# or paste a service account JSON on a single line if your org allows keys.
GSC_SERVICE_ACCOUNT_KEY=

# Free image APIs
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Cloudflare Pages deploy (GitHub Actions secrets)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub token (auto-injected as GITHUB_TOKEN in Actions; set GH_TOKEN for local)
GH_TOKEN=

# Article generation throttle
MAX_ARTICLES_PER_RUN=2
